* text=auto
*.py text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
# Hash-pinned evidence (manifests, evidence JSON) must keep identical bytes on every checkout,
# regardless of core.autocrlf on Windows.
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
